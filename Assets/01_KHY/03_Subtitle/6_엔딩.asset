  m_Script: {fileID: 11500000, guid: 11a987a2e54cb2049b36ad32b48748e7, type: 3}
  m_Name: "6_\uC5D4\uB529"
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleData
  entries:
  - startTime: 0
    endTime: 1.64
    koText: "\uC9C4\uC2EC \uC5B4\uB9B0 \uB9C8\uC74C"
    enText: "A heart full of sincerity\u2014"
  - startTime: 1.8666667
    endTime: 5.1466665
    koText: "\uADF8\uAC8C \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uADC0\uD55C \uC57D\uC778\uAC00
      \uBD10\uC694"
    enText: that must be the most precious medicine in the world
  - startTime: 5.4333334
    endTime: 10.193334
    koText: "\uC624\uB79C \uC138\uC6D4 \uB9C8\uC744\uC744 \uB3CC\uBD10\uC654\uC9C0\uB9CC,
      \uC624\uB298\uC740 \uC624\uB798 \uAE30\uC5B5\uB420 \uAC83 \uAC19\uB124\uC694"
    enText: I've watched over this village for ages, but today is a day I'll remember
      for a long time
  - startTime: 11.65
    endTime: 13.82
    koText: "\uC544\uC774\uAC00 \uC9D1\uC5D0 \uB3C4\uCC29\uD588\uC5B4\uC694"
    enText: The child has arrived home
  - startTime: 14.416667
    endTime: 17.426666
    koText: "\uB2E4\uB140\uC654\uC2B5\uB2C8\uB2E4! \uC5BC\uB978 \uC57D \uB4DC\uC138\uC694!"
    enText: I'm back! Please take this medicine right away!
  - startTime: 17.683332
    endTime: 20.613333
    koText: "\uC800\uB3C4 \uC774\uC81C \uD3B8\uD558\uAC8C \uC26C\uB7EC \uAC08 \uC218
      \uC788\uACA0\uB124\uC694"
    enText: Now I can finally go rest in peace
